# Copy this file to .env and fill in your values. .env is gitignored.
# Restart `npm run dev` after changing any of these.

# Supabase project settings (Project Settings > API).
# The anon key is designed for browser use; database access is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only OpenRouteService key for Netlify's estimate-leg function.
# Never prefix this with VITE_: it must not be sent to the browser.
ORS_API_KEY=

# Gemini API key for the Travel AI page (https://aistudio.google.com/apikey).
# NOTE: anything prefixed VITE_ is embedded into the browser bundle — see the
# security notes in README.md before using a key with a real billing account.
VITE_GEMINI_API_KEY=

# Admin gate (defaults to admin9 / admin9 if unset). This is a UI convenience
# gate only — it is not real security.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=
